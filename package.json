{
  "name": "tamilnandu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShankarSomu/tamilnandu.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "db:init:local": "wrangler d1 execute tamilnandu-waitlist --local --file=schema.sql",
    "db:init": "wrangler d1 execute tamilnandu-waitlist --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute tamilnandu-waitlist --local --file=migrations/0001_add_message.sql",
    "db:migrate": "wrangler d1 execute tamilnandu-waitlist --remote --file=migrations/0001_add_message.sql",
    "preview": "npm run build && wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name=tamilnandu"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "wrangler": "^4.152.0"
  }
}
